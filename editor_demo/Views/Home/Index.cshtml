@using TXTextControl.Web.MVC

@{
    ViewData["Title"] = "Edit Document";
}

@* @Html.Raw(ViewBag.Document) *@

<div class="demo">

    <div class="tx-container">

        @{
            // string jsonData = System.IO.File.ReadAllText(Server.MapPath("~/App_Data/Documents/acme_data.json"));
        }
        @if (ViewBag.TemplateLoaded == true)
        {
            @Html.TXTextControl().TextControl().LoadText(ViewBag.TemplateDocument, TXTextControl.Web.StringStreamType.HTMLFormat).Render()
        }
        else
        {
            <div class="alert alert-danger m-3">
                <h6>Error Loading Template</h6>
                <p>@ViewBag.ErrorMessage</p>
                <p>Please ensure the template file exists</p>
            </div>
        }
        @* @Html.TXTextControl().TextControl().LoadText(ViewBag.TemplateDocument,TXTextControl.Web.StringStreamType.RichTextFormat).Render() *@
    </div>

    <div class="mt-3">
        <div class="btn-group" role="group">
            <button onclick="saveDocument()" class="btn btn-primary">
                <i class="fas fa-save"></i> Save Document
            </button>
            <button onclick="showSaveAsDialog()" class="btn btn-secondary">
                <i class="fas fa-save"></i> Save As...
            </button>
            <button onclick="Merge()" class="btn btn-success">
                <i class="fas fa-database"></i> Merge Data
            </button>
            <button onclick="Reset()" class="btn btn-outline-warning">
                <i class="fas fa-undo"></i> Reload Template
            </button>
        </div>
    </div>

</div>

@* GenerateOrderDocument(order, "Documents/template.docx", "Documents/output.pdf"); *@
<script>

    function getMergeFields() {
        fetch('/Home/GetMergeFields', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const fieldsList = document.getElementById('merge-fields-list');
                if (data.fields.length > 0) {
                    fieldsList.innerHTML = data.fields.map(field =>
                        `<span class="badge badge-secondary mr-1 mb-1">${field}</span>`
                    ).join('');
                } else {
                    fieldsList.innerHTML = '<small class="text-muted">No merge fields found</small>';
                }
                showMessage('Merge fields loaded!', 'success');
            } else {
                showMessage('Error getting merge fields: ' + data.error, 'error');
            }
        })
        .catch(error => {
            showMessage('Error: ' + error.message, 'error');
        });
    }

    function resetToTemplate() {
        showMessage('Resetting to original template...', 'info');
        window.location.reload();
    }
    // Function to save the document to the original file
    function saveDocument() {
        showMessage('Saving document...', 'info');

        // Get the content from TX Text Control
        var content = TXTextControl.getHTML();

        fetch('/Home/SaveDocumentJson', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ content: content })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showMessage(data.message, 'success');
            } else {
                showMessage('Error saving document: ' + data.error, 'error');
            }
        })
        .catch(error => {
            showMessage('Error: ' + error.message, 'error');
        });
    }

    // Function to show the Save As dialog
    function showSaveAsDialog() {
        $('#saveAsModal').modal('show');
        $('#fileName').val(''); // Clear the input
    }

    // Function to save the document with a new name
    function saveDocumentAs() {
        var fileName = document.getElementById('fileName').value.trim();

        if (!fileName) {
            showMessage('Please enter a filename', 'error');
            return;
        }

        if (!fileName.endsWith('.docx')) {
            fileName += '.docx';
        }

        showMessage('Saving document as ' + fileName + '...', 'info');

        // Get the content from TX Text Control
        var content = TXTextControl.getHTML();

        fetch('/Home/SaveDocumentAs', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                content: content,
                fileName: fileName
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showMessage(data.message, 'success');
                $('#saveAsModal').modal('hide');
            } else {
                showMessage('Error saving document: ' + data.error, 'error');
            }
        })
        .catch(error => {
            showMessage('Error: ' + error.message, 'error');
        });
    }

    // Utility function to show messages
    function showMessage(message, type) {
        const messageArea = document.getElementById('message-area');
        const alertClass = type === 'success' ? 'alert-success' :
                          type === 'error' ? 'alert-danger' : 'alert-info';

        messageArea.innerHTML = `
            <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="close" data-dismiss="alert">
                    <span>&times;</span>
                </button>
            </div>
        `;

        // Auto-hide success messages after 3 seconds
        if (type === 'success' || type === 'info') {
            setTimeout(() => {
                $('.alert').alert('close');
            }, 3000);
        }
    }


    // Auto-load merge fields when page loads
    document.addEventListener('DOMContentLoaded', function() {
        @* getMergeFields(); *@
    });

</script>
