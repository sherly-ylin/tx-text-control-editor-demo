@using TXTextControl.Web.MVC

@{
    ViewData["Title"] = "Edit Document";
}

@* @Html.Raw(ViewBag.Document) *@

<div class="demo">

    <div class="tx-container">

        @{
            // string jsonData = System.IO.File.ReadAllText(Server.MapPath("~/App_Data/Documents/acme_data.json"));
        }
        @if (ViewBag.TemplateLoaded == true)
        {
            @Html.TXTextControl().TextControl().LoadText(ViewBag.TemplateDocument, TXTextControl.Web.StringStreamType.HTMLFormat).Render()
        }
        else
        {
            <div class="alert alert-danger m-3">
                <h6>Error Loading Template</h6>
                <p>@ViewBag.ErrorMessage</p>
            </div>
        }
        @* @Html.TXTextControl().TextControl().LoadText(ViewBag.TemplateDocument,TXTextControl.Web.StringStreamType.RichTextFormat).Render() *@
    </div>

    <div class="mt-3">
        <div class="btn-group" role="group">
            <button onclick="saveDocument()" class="btn btn-primary">
                <i class="fas fa-save"></i> Save Document
            </button>
            <button onclick="showSaveAsDialog()" class="btn btn-secondary">
                <i class="fas fa-save"></i> Save As...
            </button>
            <button onclick="generateDBOrderDocument(7262)" class="btn btn-success">
                <i class="fas fa-database"></i> Load Order 7262
            </button>
            <button onclick="generateDBOrderDocument(7262, true)" class="btn btn-outline-warning">
                <i class="fas fa-undo"></i> Load Order body bundle
            </button>
        </div>
    </div>
    <div id="status-messages" class="mt-3"></div>
</div>

@* GenerateOrderDocument(order, "Documents/template.docx", "Documents/output.pdf"); *@
<script>
    function generateDBOrderDocument(orderId, byBundle = false) {
        showMessage('Generating document...', 'info');

        fetch('/Home/GenerateDBOrderDocument', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ orderId: orderId, byBundle: byBundle})
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showMessage(data.message, 'success');
                // Optionally redirect to the generated document
                @* window.location.href = data.filePath; *@
            } else {
                showMessage('Error generating document: ' + data.error, 'error');
            }
        })
        .catch(error => {
            showMessage('Error: ' + error.message, 'error');
        });
    }
    function resetToTemplate() {
        showMessage('Resetting to original template...', 'info');
        window.location.reload();
    }
    // Function to save the document to the original file
    function saveDocument() {
        showMessage('Saving document...', 'info');

        // Get the content from TX Text Control
        var content = TXTextControl.getHTML();

        fetch('/Home/SaveDocument', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ content: content })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showMessage(data.message, 'success');
            } else {
                showMessage('Error saving document: ' + data.error, 'error');
            }
        })
        .catch(error => {
            showMessage('Error: ' + error.message, 'error');
        });
    }

    // Function to show the Save As dialog
    function showSaveAsDialog() {
        $('#saveAsModal').modal('show');
        $('#fileName').val(''); // Clear the input
    }

    // Function to save the document with a new name
    function saveDocumentAs() {
        var fileName = document.getElementById('fileName').value.trim();

        if (!fileName) {
            showMessage('Please enter a filename', 'error');
            return;
        }

        if (!fileName.endsWith('.docx')) {
            fileName += '.docx';
        }

        showMessage('Saving document as ' + fileName + '...', 'info');

        // Get the content from TX Text Control
        var content = TXTextControl.getHTML();

        fetch('/Home/SaveDocumentAs', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                content: content,
                fileName: fileName
            })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showMessage(data.message, 'success');
                $('#saveAsModal').modal('hide');
            } else {
                showMessage('Error saving document: ' + data.error, 'error');
            }
        })
        .catch(error => {
            showMessage('Error: ' + error.message, 'error');
        });
    }

    function showMessage(message, type = 'info') {
        const alertClass = type === 'error' ? 'alert-danger' : 
                          type === 'success' ? 'alert-success' : 'alert-info';
        
        const html = `<div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="close" data-dismiss="alert">
                            <span>&times;</span>
                        </button>
                      </div>`;
        
        document.getElementById('status-messages').innerHTML = html;
        
        // Auto-hide after 5 seconds
        setTimeout(() => {
            const alert = document.querySelector('.alert');
            if (alert) {
                alert.remove();
            }
        }, 5000);
    }


    // Auto-load merge fields when page loads
    document.addEventListener('DOMContentLoaded', function() {
        @* getMergeFields(); *@
    });

</script>
